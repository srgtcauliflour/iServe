.DS_Store
.build/
build/
DerivedData/
*.xcresult/
*.xcuserstate
xcuserdata/
iServe.xcodeproj/
__pycache__/
*.pyc
# CI-populated only (php-embed.yml downloads libphp.a + headers here to
# build the iServeWithPHP target) — never committed, per ADR-0009's
# "reproducible from source, not a vendored binary blob" rule.
PHP/Vendor/
# fixtures/sqlite.php deletes this itself on every run (before and after);
# ignored too in case a crashed/interrupted run ever leaves one behind.
PHP/Bridge/Tests/fixtures/*.sqlite
# fixtures/upload.php deletes this itself on every run (before and after);
# same reasoning as the .sqlite rule above.
PHP/Bridge/Tests/fixtures/uploaded-output.txt
# Generated fresh each CI run by patches/generate_curl_ca_bundle.py from
# curl's own official, regularly-updated CA bundle distribution — never
# committed, same "reproducible from source" reasoning as PHP/Vendor/ above.
PHP/Bridge/iserve_curl_ca_bundle.c
